[Unit]
Description=llm.gw daemon - llama.cpp lifecycle daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/ai/llm.gw/bin/llmd
WorkingDirectory=%h/ai/llm.gw
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
